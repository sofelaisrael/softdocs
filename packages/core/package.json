{
  "name": "@sofelaisrael/core",
  "version": "0.1.0",
  "description": "Core library for Versio — MDX parsing, versioned content indexing, navigation, and theme building. Zero React dependency.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.2.0",
    "chokidar": "^4.0.0",
    "js-yaml": "^4.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20"
  }
}
