{
  "name": "@versio/ui",
  "version": "0.1.0",
  "description": "React/Next.js UI components for Versio documentation sites — sidebar, scroll-spy TOC, version picker, MDX components, and more.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
